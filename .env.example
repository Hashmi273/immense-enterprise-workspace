# ==============================================================================
# IMMENSE ENTERPRISE WORKSPACE: CLIENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Target: immense-enterprise-workspace
# Production Domain: portal.immense.in
#
# IMPORTANT SECURITY RULES:
# 1. ONLY include the public Supabase URL and public Anonymous API Key here.
# 2. NEVER add SUPABASE_SERVICE_ROLE_KEY or service_role key to this file.
# 3. This is a client-side Single Page Application (SPA); any variable prefixed
#    with VITE_ is bundled and visible to client browsers.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co

# Supabase Anonymous Public API Key (JWT public anon key)
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
